# Copy to config.local.env and fill in. Never commit config.local.env.
#
# On CI, this file is generated by the workflow from repository secrets.
# Locally, do: cp config/config.local.env.example config/config.local.env

# Management IP allowed to reach the box after containment kicks in.
# Must be a bare IPv4 address. No hostname, no CIDR, no port.
MGMT_IP=203.0.113.10

# Where containment notifications are POSTed.
# Public ntfy.sh URLs are refused unless ALLOW_PUBLIC_NTFY=1.
WEBHOOK_URL=https://ntfy.internal.example.com/eiciel-alerts
# ALLOW_PUBLIC_NTFY=1

# Space-separated systemd units stopped during containment.
STOP_SERVICES="sshd nginx apache2 postgresql mysql mariadb redis-server docker"

# SSH public key for the 'admin' user. Leave empty for console-only access.
SSH_AUTHORIZED_KEY=""

# 1 = include a persistence partition, 0 = pure live ISO.
ENABLE_PERSISTENCE=0

# auto = ship dashboard if eiciel-app-dist exists; 0/1 to force.
INCLUDE_DASHBOARD=auto

# Containment cooldown (seconds). Prevents alert storms.
COOLDOWN_SECONDS=600

# Hostname baked into the ISO.
HOSTNAME_NEW=eiciel-srv
